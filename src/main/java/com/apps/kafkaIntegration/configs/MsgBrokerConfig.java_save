package     com.apps.artemisIntegration.configs;

import      org.apache.activemq.camel.component.ActiveMQComponent;
import      org.apache.activemq.ActiveMQConnectionFactory;

import      org.springframework.beans.factory.annotation.Value;
import      org.springframework.context.annotation.Bean;
import      org.springframework.context.annotation.Configuration;

import		org.slf4j.Logger;
import		org.slf4j.LoggerFactory;

@Configuration
public class MsgBrokerConfig extends ActiveMQComponent {
    private static final Logger logger = LoggerFactory.getLogger(MsgBrokerConfig.class);

    @Value("${artemis.msgbroker.uri}")
    private String brokerUri;

    @Value("${artemis.msgbroker.user}")
    private String userName;

    @Value("${artemis.msgbroker.password}")
    private String password;

    @Value("${artemis.msgbroker.concurrentConsumers}")
    private int concurrentConsumers;

    @Value("${artemis.msgbroker.maxConcurrentConsumers}")
    private int maxConcurrentConsumers;

    @Bean("msgbroker")
    public ActiveMQComponent msgbroker() throws Exception {
        ActiveMQConnectionFactory connectionFactory = new ActiveMQConnectionFactory();
        connectionFactory.setBrokerURL(brokerUri);
        //connectionFactory.setUserName(userName);
        //connectionFactory.setPassword(password);

        ActiveMQComponent mqComponent = new ActiveMQComponent();
        mqComponent.setConnectionFactory(connectionFactory);
        mqComponent.setConcurrentConsumers(concurrentConsumers);
        mqComponent.setMaxConcurrentConsumers(maxConcurrentConsumers);

        return mqComponent;
    }
}